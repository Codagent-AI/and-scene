import { AnimatePresence } from 'motion/react'
import { Presentation } from '../../presentation-kit/Presentation'
import { Appear, Box, SceneLayer } from '../../presentation-kit/nodes'
import type { SceneProps, Step } from '../../presentation-kit/types'
import './style.css'
function Scene({ payload }: SceneProps<boolean>) {
  return <SceneLayer><Box id="persistent">Persistent entity</Box><AnimatePresence>{payload && <Appear key="new"><Box id="new">New entity</Box></Appear>}</AnimatePresence></SceneLayer>
}
const steps: Step<boolean>[] = [false, true, false].map((payload, i) => ({ id: `step-${i}`, era: 'introduction', title: `Step ${i + 1}`, caption: 'Describe this step.', Scene, payload, groupKey: 'scene' }))
export default function Talk() { return <Presentation title="Presentation" steps={steps} /> }
