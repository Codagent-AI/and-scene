import { AnimatePresence } from 'motion/react'
import { Box, Appear, SceneLayer, type SceneProps, type Step } from '../../../presentation-kit'
import { entities } from '../entities'
interface Payload { label: string; showExtra: boolean }
function Scene({ payload }: SceneProps<Payload>) {
  return <SceneLayer>
    <Box entityId={entities.anchor} className="anchor" style={{ position: 'absolute', left: 100, top: 100 }}>{payload.label}</Box>
    <AnimatePresence>{payload.showExtra && <Appear key={entities.extra}><Box entityId={entities.extra} style={{ position: 'absolute', left: 400, top: 100 }}>New entity</Box></Appear>}</AnimatePresence>
  </SceneLayer>
}
export const STEPS: Step<Payload>[] = [
  { id: 'start', era: 'opening', title: 'YOUR_TITLE', caption: 'YOUR_CAPTION', groupKey: 'diagram', Scene, payload: { label: 'Anchor', showExtra: false } },
  { id: 'grow', era: 'opening', title: 'YOUR_NEXT_TITLE', caption: 'YOUR_NEXT_CAPTION', groupKey: 'diagram', Scene, payload: { label: 'Anchor evolves', showExtra: true } },
]
