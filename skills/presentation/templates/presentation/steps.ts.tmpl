import type { Step } from '../../presentation-kit'
import { Scene, type ScenePayload } from './Scene'

const beats = [
  { id: 'first', era: 'era one', title: 'First beat', caption: 'What this step says, in a sentence or two.' },
]

export const STEPS: Step<ScenePayload>[] = beats.map((beat, i) => ({
  ...beat,
  Scene,
  payload: { step: i + 1 },
  groupKey: '{{slug}}',
}))
