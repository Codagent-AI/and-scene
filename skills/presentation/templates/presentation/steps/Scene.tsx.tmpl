import { Sparkles, Star } from 'lucide-react'
import { Appear, Arrow, Box, SceneLayer, type SceneProps } from '../../../presentation-kit'
import { ID, LINK, POS } from '../entities'

export interface ScenePayload {
  /** 1-based beat of the story; entities accumulate as it grows. */
  beat: number
}

/**
 * One persistent scene for every step. An entity mounts at the beat that introduces it
 * (wrapped in <Appear>) and then keeps its id, so continuing entities morph in place. Every
 * direct child of <SceneLayer> needs a key; an <Appear> that a later step drops fades out.
 */
export function Scene({ payload: { beat } }: SceneProps<ScenePayload>) {
  return (
    <SceneLayer>
      <Box key="start" id={ID.start} Icon={Star} label="Start here" {...POS.start} />
      {beat >= 2 && (
        <Appear key="next">
          <Box id={ID.next} Icon={Sparkles} label="Then this" {...POS.next} />
          <Arrow id={ID.link} {...LINK} />
        </Appear>
      )}
    </SceneLayer>
  )
}
