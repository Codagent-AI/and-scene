/* Look and feel owned by this presentation; the scene kit supplies hooks only.
   Restyle freely: palette, type, spacing, and chrome treatments all live here. */
[data-presentation-root] {
  --bg: #121110;
  --panel: #1d1a17;
  --line: #4a4338;
  --text: #f8f3e6;
  --muted: #b3a995;
  --accent: #e6c76a;
  --good: #7bd88f;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
}

/* chrome */
[data-presentation-header] {
  gap: 0.25rem 1rem;
  padding: 0.75rem 1.5rem 0.25rem;
}
[data-presentation-marker] {
  font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--muted);
}
[data-presentation-marker-number] {
  color: var(--accent);
}
[data-presentation-step-title] {
  margin: 0;
  font-size: clamp(1.1rem, 2.2vw, 1.6rem);
  line-height: 1.2;
}
[data-presentation-footer] {
  gap: 0.75rem;
  padding: 0.5rem 1.5rem 1rem;
}
[data-presentation-step-caption] {
  margin: 0;
  max-width: 62ch;
  min-height: 3em;
  line-height: 1.5;
  color: var(--muted);
}
[data-presentation-mode='present'] [data-presentation-footer] [data-presentation-step-title] {
  font-size: clamp(1.5rem, 3.4vw, 2.6rem);
  text-align: center;
}
[data-presentation-mode='present'] [data-presentation-header] {
  justify-content: center;
}

[data-presentation-toc] {
  gap: 0.25rem;
  min-width: 9rem;
  padding: 0.5rem 0.5rem 0.5rem 1rem;
}
[data-presentation-toc-item] {
  padding: 0.4rem 0.75rem;
  border: 0;
  border-left: 2px solid transparent;
  background: transparent;
  color: var(--muted);
  text-align: left;
  cursor: pointer;
}
[data-presentation-toc-item][data-presentation-active='true'] {
  border-left-color: var(--accent);
  background: rgba(230, 199, 106, 0.14);
  color: var(--text);
  font-weight: 700;
}

[data-presentation-progress] {
  gap: 6px;
  margin-right: 1rem;
}
[data-presentation-progress-item] {
  width: 22px;
  height: 8px;
  padding: 0;
  border: 0;
  border-radius: 4px;
  background: var(--line);
  cursor: pointer;
}
[data-presentation-progress-item][data-presentation-active='true'] {
  width: 40px;
  background: var(--accent);
}
[data-presentation-controls] {
  gap: 0.5rem;
}
[data-presentation-prev],
[data-presentation-next] {
  padding: 0.35rem 0.9rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: transparent;
  color: var(--text);
  cursor: pointer;
}
[data-presentation-prev]:hover,
[data-presentation-next]:hover {
  background: var(--panel);
}
[data-presentation-attribution] {
  padding: 0.25rem 0.75rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--accent);
  font-size: 0.85rem;
  text-decoration: none;
}
[data-presentation-attribution]:hover {
  background: var(--panel);
}
[data-presentation-root] button:focus-visible,
[data-presentation-root] a:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* entities */
[data-presentation-node='box'] {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--panel);
  font-size: 13px;
  white-space: nowrap;
}
[data-presentation-glyph] {
  width: 18px;
  height: 18px;
  color: var(--accent);
  flex: none;
}
[data-presentation-node='label'] {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
}
[data-presentation-node='label'] [data-presentation-glyph] {
  width: 12px;
  height: 12px;
}
[data-presentation-node='chip'] {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--bg);
  font-size: 12px;
  white-space: nowrap;
}
[data-presentation-node='chip'] [data-presentation-glyph] {
  width: 14px;
  height: 14px;
}
[data-presentation-node='arrow'] {
  color: var(--accent);
}
[data-presentation-node='arrow'] path {
  stroke-width: 1.6;
}
[data-presentation-node='emphasis'] {
  border: 2px solid var(--accent);
  border-radius: 14px;
}
[data-presentation-node='frame'] {
  border: 2px dashed var(--accent);
  border-radius: 16px;
}
[data-presentation-node='frame'] [data-presentation-label] {
  position: absolute;
  top: -11px;
  left: 28px;
  padding: 0 10px;
  background: var(--bg);
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
}
