/*
 * Look of "__TITLE__". Owned by this presentation, not by the scene kit.
 * Scope every rule under .__CLASS__ and target the kit's stable hooks:
 *
 *   [data-presentation-node='box' | 'label' | 'arrow' | 'frame' | 'emphasis' | 'symbol-chip']
 *   [data-presentation-entity='<id>']     one entity
 *   [data-presentation-arrow-line] [data-presentation-arrow-head]   arrow stroke and fill
 *   [data-presentation-marker] [data-presentation-title] [data-presentation-caption]
 *   [data-presentation-progress-item] [data-presentation-toc-item] [data-presentation-nav]
 *   [data-presentation-active]            the current progress item / ToC entry
 *   [data-presentation-attribution]       the "made by and-scene" link
 *   [data-presentation-allow-overlap]     mark a subtree whose overlap is intentional and readable
 */
